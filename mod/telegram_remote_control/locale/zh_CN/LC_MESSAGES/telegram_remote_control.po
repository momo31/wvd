msgid "텔레그램 원격 제어"
msgstr "Telegram 远程控制"

msgid "원격 제어 사용"
msgstr "启用远程控制"

msgid "허용 Chat ID"
msgstr "允许的 Chat ID"

msgid "설정 저장 및 적용"
msgstr "保存并应用"

msgid "연결 테스트"
msgstr "连接测试"

msgid "저장 및 적용 완료"
msgstr "设置已保存并应用"

msgid "Bot Token"
msgstr "Bot Token"

msgid "연결 확인 중..."
msgstr "正在检查连接..."

msgid "연결됨"
msgstr "已连接"

msgid "연결 실패"
msgstr "连接失败"

msgid "시작 요청을 접수했습니다."
msgstr "已收到启动请求。"

msgid "안전 정지 요청을 접수했습니다."
msgstr "已收到安全停止请求。"

msgid "즉시 중지"
msgstr "立即停止"

msgid "에뮬레이터 재부팅을 시작했습니다. 실행 중인 매크로는 먼저 중지됩니다."
msgstr "模拟器重启已开始。正在运行的脚本将先停止。"

msgid "에뮬레이터 재부팅이 이미 진행 중입니다."
msgstr "模拟器正在重启。"

msgid "에뮬레이터 재부팅이 완료되었습니다."
msgstr "模拟器重启完成。"

msgid "에뮬레이터 재부팅에 실패했습니다. stat 명령으로 로그를 확인하세요."
msgstr "模拟器重启失败。请使用 stat 命令检查日志。"

msgid "선택할 수 있는 퀘스트 목표가 없습니다."
msgstr "没有可选择的任务目标。"

msgid "퀘스트 분류를 선택하세요."
msgstr "请选择任务类别。"

#, python-format
msgid "퀘스트 목표를 선택하세요: %s"
msgstr "请选择任务目标：%s"

msgid "분류로 돌아가기"
msgstr "返回类别"

#, python-format
msgid ""
"퀘스트 목표를 '%s'(으)로 변경했습니다.\n"
"/start 명령으로 실행하세요."
msgstr ""
"任务目标已更改为“%s”。\n"
"请使用 /start 命令运行。"

msgid "퀘스트 목표 저장에 실패했습니다. stat 명령으로 로그를 확인하세요."
msgstr "保存任务目标失败。请使用 stat 命令检查日志。"

msgid "퀘스트 목록이 변경되었습니다. /quest 명령으로 다시 여세요."
msgstr "任务列表已更改。请使用 /quest 命令重新打开。"

msgid "퀘스트 목표는 매크로가 완전히 정지된 상태에서만 변경할 수 있습니다."
msgstr "只有在脚本完全停止时才能更改任务目标。"

msgid "Bot Token 형식이 올바르지 않습니다."
msgstr "Bot Token 格式无效。"

msgid "허용 Chat ID는 양의 정수여야 합니다."
msgstr "允许的 Chat ID 必须为正整数。"

msgid "허용 Chat ID가 올바르지 않습니다."
msgstr "允许的 Chat ID 无效。"

msgid "허용 Chat ID 범위를 확인하십시오."
msgstr "请检查允许的 Chat ID 范围。"

msgid "Telegram 연결 테스트 시간이 초과되었습니다."
msgstr "Telegram 连接测试超时。"

msgid "Telegram 연결 테스트에 실패했습니다."
msgstr "Telegram 连接测试失败。"
